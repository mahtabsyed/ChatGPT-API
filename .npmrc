# Supply-chain defence: do not install npm packages published in the last 10 days,
# so a freshly compromised upstream release cannot be pulled in before the
# ecosystem detects and yanks it. This is a relative window (self-maintaining,
# no date to bump). Requires npm v11+. Pair with `npm ci` so the lockfile is
# honoured too. There is no package.json in this repo yet; this future-proofs
# any frontend added later.
min-release-age=10
